# Copy this file to .env.local and fill in your own values. NEVER commit .env.local.
# Use the PUBLISHABLE (or legacy "anon") key. NEVER use the service_role / secret key here.
# The URL must end at .supabase.co (no /rest/v1, no trailing slash).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
